 _Amp;\nuniform \tfloat _Speed;\nuniform \tfloat _Freq;\nuniform \tfloat _Damp;\nuniform \tfloat _Falloff;\nUNITY_LOCATION(0) uniform mediump sampler2D _MainTex;\nin mediump vec4 vs_COLOR0;\nin highp vec2 vs_TEXCOORD0;\nlayout(location = 0) out mediump vec4 SV_Target0;\nvec4 u_xlat0;\nint u_xlati0;\nvec4 u_xlat1;\nmediump vec4 u_xlat16_1;\nfloat u_xlat2;\nbool u_xlatb2;\nvec2 u_xlat4;\nbvec2 u_xlatb4;\nvoid main()\n{\n    u_xlat0.x = vs_TEXCOORD0.x + (-_HitU);\n    u_xlat2 = _Speed * _WaveAge + -abs(u_xlat0.x);\n    u_xlat0.x = abs(u_xlat0.x) * _Falloff + 1.0;\n    u_xlat4.x = u_xlat2 * (-_Damp);\n    u_xlat4.x = u_xlat4.x * 1.44269502;\n    u_xlat4.x = exp2(u_xlat4.x);\n    u_xlat0.x = u_xlat4.x / u_xlat0.x;\n    u_xlat0.x = u_xlat0.x * (-_Amp);\n    u_xlat4.x = u_xlat2 * _Freq;\n    u_xlatb2 = 0.0<u_xlat2;\n    u_xlat4.x = sin(u_xlat4.x);\n    u_xlat0.x = u_xlat4.x * u_xlat0.x;\n    u_xlati0 = u_xlatb2 ? floatBitsToInt(u_xlat0.x) : int(0);\n    u_xlatb2 = _WaveAge>=0.0;\n    u_xlat0.x = u_xlatb2 ? intBitsToFloat(u_xlati0) : float(0.0);\n    u_xlat0.y = (-u_xlat0.x) + vs_TEXCOORD0.y;\n    u_xlatb4.x = u_xlat0.y>=0.0;\n    u_xlatb4.y = 1.0>=u_xlat0.y;\n    u_xlat4.x = u_xlatb4.x ? float(1.0) : 0.0;\n    u_xlat4.y = u_xlatb4.y ? float(1.0) : 0.0;\n;\n    u_xlat4.x = u_xlat4.y * u_xlat4.x;\n    u_xlat0.x = vs_TEXCOORD0.x;\n    u_xlat16_1 = texture(_MainTex, u_xlat0.xy);\n    u_xlat1 = u_xlat16_1 * vs_COLOR0;\n    u_xlat0 = u_xlat4.xxxx * u_xlat1;\n    SV_Target0.xyz = u_xlat0.www * u_xlat0.xyz;\n    SV_Target0.w = u_xlat0.w;\n    return;\n}\n\n"]